{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  commitMessagePrefix: 'chore(deps):',
  timezone: 'Europe/Berlin',
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  automerge: false,
  minimumReleaseAge: '7 days',
  minimumReleaseAgeBehaviour: 'timestamp-required',
  internalChecksFilter: 'strict',
  enabledManagers: [
    'github-actions',
    'custom.regex',
  ],

  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.pkr\\.hcl$/',
      ],
      matchStrings: [
        'source[\\s]+=[\\s]+"github\\.com/(?<depName>\\S*)"[\\s]+version[\\s]+=[\\s]+"(?<currentValue>\\S*)"'
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: '{{#if (equals depName "hetznercloud/hcloud")}}hetznercloud/packer-plugin-hcloud{{else}}{{depName}}{{/if}}',
    },
  ],

  packageRules: [
    {
      // ===========================================================================
      // GitHub Actions
      // ===========================================================================  
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        '*',
      ],
      labels: [
        'dependencies',
        'github_actions',
      ],
      draftPR: true,
      additionalBranchPrefix: 'github_action/',
      branchTopic: '{{depNameSanitized}}-{{#if newVersion}}{{newVersion}}{{else}}{{currentValue}}-{{newDigest}}{{/if}}',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '{{#if newVersion}}from {{currentVersion}} to {{newVersion}}{{else}}{{newValue}} from {{currentDigestShort}} to {{newDigestShort}}{{/if}}',
    },
    {
      // ===========================================================================
      // Packer
      // ===========================================================================
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'hetznercloud/packer-plugin-hcloud',
      ],
      labels: [
        'dependencies',
        'packer',
      ],
      draftPR: true,
      additionalBranchPrefix: 'packer/',
      branchTopic: '{{depNameSanitized}}-{{newVersion}}',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: 'from {{currentVersion}} to {{newVersion}}',
    },
  ],
}
